<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>DropAffy · Créer mon compte</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      background-color: #f7f9fc;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 1.5rem 1rem;
    }

    .signup-card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border-radius: 32px;
      padding: 2rem 1.75rem 1.75rem;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.03), 0 5px 12px rgba(0, 0, 0, 0.02);
      transition: all 0.2s ease;
    }

    /* En-tête */
    .logo {
      font-size: 1.9rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #0a2540;
      line-height: 1.2;
      margin-bottom: 0.2rem;
    }

    .logo span {
      color: #1f8b7a; /* touche de couleur discrète et moderne */
    }

    .tagline {
      font-size: 0.95rem;
      color: #5e6f8d;
      font-weight: 400;
      margin-bottom: 2rem;
      letter-spacing: -0.01em;
      border-left: 3px solid #1f8b7a;
      padding-left: 0.75rem;
    }

    /* Titre formulaire */
    h1 {
      font-size: 1.6rem;
      font-weight: 600;
      color: #0a2540;
      margin-bottom: 1.75rem;
      letter-spacing: -0.02em;
    }

    /* Champs */
    .field {
      margin-bottom: 1.25rem;
    }

    label {
      display: block;
      font-size: 0.85rem;
      font-weight: 500;
      color: #2e405b;
      margin-bottom: 0.35rem;
      letter-spacing: -0.01em;
    }

    input[type="text"],
    input[type="tel"],
    input[type="password"] {
      width: 100%;
      padding: 0.9rem 1rem;
      font-size: 1rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 16px;
      background: #ffffff;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      outline: none;
      color: #0a2540;
      font-weight: 400;
    }

    input:focus {
      border-color: #1f8b7a;
      box-shadow: 0 0 0 4px rgba(31, 139, 122, 0.08);
    }

    input::placeholder {
      color: #b0bedb;
      font-weight: 300;
      font-size: 0.95rem;
    }

    /* Case à cocher */
    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1.5rem 0 1.75rem;
    }

    .checkbox-row input[type="checkbox"] {
      width: 1.25rem;
      height: 1.25rem;
      accent-color: #1f8b7a;
      border-radius: 6px;
      border: 1.5px solid #cbd5e1;
      cursor: pointer;
      flex-shrink: 0;
    }

    .checkbox-row label {
      font-size: 0.9rem;
      font-weight: 400;
      color: #2e405b;
      margin-bottom: 0;
      cursor: pointer;
      line-height: 1.4;
    }

    /* Bouton principal */
    .btn-primary {
      width: 100%;
      background: #1f8b7a;
      color: white;
      border: none;
      padding: 1rem 1.5rem;
      font-size: 1.05rem;
      font-weight: 600;
      border-radius: 40px;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.1s ease;
      letter-spacing: -0.01em;
      box-shadow: 0 8px 18px -6px rgba(31, 139, 122, 0.3);
      margin-bottom: 0.75rem;
    }

    .btn-primary:hover {
      background: #157a6a;
    }

    .btn-primary:active {
      transform: scale(0.98);
      background: #106b5c;
    }

    /* Lien connexion */
    .login-link {
      text-align: center;
      font-size: 0.9rem;
      color: #5e6f8d;
      margin-bottom: 1.75rem;
    }

    .login-link a {
      color: #1f8b7a;
      font-weight: 600;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }

    .login-link a:hover {
      border-bottom-color: #1f8b7a;
    }

    /* Message court */
    .info-message {
      font-size: 0.85rem;
      color: #6b7d9e;
      text-align: center;
      line-height: 1.5;
      padding-top: 0.75rem;
      border-top: 1px solid #eef2f7;
      margin-top: 0.5rem;
      font-weight: 400;
      letter-spacing: -0.01em;
    }

    /* Petite touche de respiration sur mobile */
    @media (max-width: 380px) {
      .signup-card {
        padding: 1.5rem 1.25rem 1.25rem;
        border-radius: 28px;
      }

      .logo {
        font-size: 1.7rem;
      }

      h1 {
        font-size: 1.45rem;
        margin-bottom: 1.5rem;
      }

      .btn-primary {
        padding: 0.9rem 1.25rem;
      }
    }
  </style>
</head>
<body>
  <div class="signup-card" role="main">
    <!-- En-tête avec logo et accroche -->
    <div class="logo">
      Drop<span>Affy</span>
    </div>
    <div class="tagline">
      Rejoignez le réseau commercial.
    </div>

    <!-- Titre du formulaire -->
    <h1>Créer mon compte</h1>

    <!-- Formulaire d'inscription -->
    <form id="signupForm" action="#" method="post" novalidate>
      <div class="field">
        <label for="fullname">Nom complet</label>
        <input type="text" id="fullname" name="fullname" placeholder="Ex: Marie Dupont" autocomplete="name" required>
      </div>

      <div class="field">
        <label for="phone">Numéro de téléphone</label>
        <input type="tel" id="phone" name="phone" placeholder="Ex: 06 12 34 56 78" autocomplete="tel" required>
      </div>

      <div class="field">
        <label for="city">Ville</label>
        <input type="text" id="city" name="city" placeholder="Ex: Paris" autocomplete="address-level2" required>
      </div>

      <div class="field">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" required>
      </div>

      <!-- Case à cocher conditions -->
      <div class="checkbox-row">
        <input type="checkbox" id="terms" name="terms" required>
        <label for="terms">J'accepte les conditions d'utilisation.</label>
      </div>

      <!-- Bouton principal -->
      <button type="submit" class="btn-primary" id="submitBtn">Créer mon compte</button>

      <!-- Lien connexion -->
      <div class="login-link">
        Déjà membre ? <a href="#">Se connecter</a>
      </div>
    </form>

    <!-- Message court sous le formulaire -->
    <div class="info-message">
      Un seul compte pour découvrir des offres, développer votre réseau et accéder aux opportunités DropAffy.
    </div>
  </div>

  <script>
    (function() {
      const form = document.getElementById('signupForm');
      
      // Gestion de la soumission : redirection immédiate vers le tableau de bord membre
      form.addEventListener('submit', function(event) {
        event.preventDefault(); // empêche l'envoi réel pour la démo

        // Récupération des champs (validation minimale côté client)
        const fullname = document.getElementById('fullname').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const city = document.getElementById('city').value.trim();
        const password = document.getElementById('password').value;
        const termsChecked = document.getElementById('terms').checked;

        // Vérification simple : tous les champs remplis + conditions cochées
        if (!fullname || !phone || !city || !password) {
          alert('Veuillez remplir tous les champs.');
          return;
        }

        if (!termsChecked) {
          alert("Veuillez accepter les conditions d'utilisation.");
          return;
        }

        // Simulation d'une inscription réussie et redirection vers le tableau de bord
        // (dans une vraie application, on enverrait les données à une API)
        // Redirection directe — l'utilisateur est maintenant un Membre DropAffy.
        window.location.href = '/dashboard'; // Remplacez par l'URL réelle du tableau de bord
      });

      // Petite amélioration : on peut aussi rediriger si on clique sur "Se connecter"
      // Mais ce n'est pas demandé explicitement, donc on laisse le lien tel quel (href="#")
      // Optionnel : prévenir que c'est une démo ? Non, on garde l'expérience propre.

      // Note: Aucun champ supplémentaire, aucun choix de profil, aucune question longue.
      // L'interface reste épurée, mobile-first, prête à être intégrée.
    })();
  </script>
</body>
</html>
